<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <AssemblyName>PANiXiDA.Core.Ef.Migrator</AssemblyName>

        <PackageId>PANiXiDA.Core.Ef.Migrator</PackageId>
        <Description>A package for automatically creating and applying Entity Framework Core migrations when launching an application. It allows you to detect changes to the DbContext model, generate migration files and, if necessary, immediately apply them to the database.</Description>
        <PackageTags>EFCore;EntityFrameworkCore;Migrations;Migrator;AutoMigration;Database;PostgreSQL;Npgsql;DotNet</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/ef-migrator</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/ef-migrator</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />

        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />

        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PANiXiDA.Core.Ef.Migrator.IntegrationTests" />
    </ItemGroup>
</Project>
